FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o monitoring -ldflags="-s -w" .

FROM alpine:latest

RUN apk add --no-cache netcat-openbsd

WORKDIR /app

COPY --from=builder /app/monitoring .
COPY scripts/run-migrations.sh .

RUN chmod +x monitoring run-migrations.sh

CMD ["./run-migrations.sh"]
