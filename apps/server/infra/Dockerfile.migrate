FROM golang:1.26-alpine AS builder

ARG VERSION=dev
ARG BUILD_TIME=unknown
ARG GIT_COMMIT=unknown

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o monitoring \
    -trimpath \
    -ldflags="-s -w \
      -X peekaping/version.Version=${VERSION} \
      -X peekaping/version.BuildTime=${BUILD_TIME} \
      -X peekaping/version.GitCommit=${GIT_COMMIT}" .

FROM alpine:3.21

RUN apk add --no-cache netcat-openbsd

WORKDIR /app

COPY --from=builder /app/monitoring .
COPY scripts/run-migrations.sh .

RUN chmod +x monitoring run-migrations.sh

CMD ["./run-migrations.sh"]
