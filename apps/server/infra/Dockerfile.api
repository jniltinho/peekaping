FROM golang:1.26-alpine AS builder

ARG VERSION=dev
ARG BUILD_TIME=unknown
ARG GIT_COMMIT=unknown

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -o monitoring \
    -trimpath \
    -ldflags="-s -w \
      -X peekaping/version.Version=${VERSION} \
      -X peekaping/version.BuildTime=${BUILD_TIME} \
      -X peekaping/version.GitCommit=${GIT_COMMIT}" .

FROM alpine:3.21

WORKDIR /app

COPY --from=builder /app/monitoring .

EXPOSE 8383

CMD ["./monitoring", "api"]
