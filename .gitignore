# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

.data

tmp

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

package-lock.json

storageState.json
apps/web/src/i18n/progress

# Frontend embed target (populated by 'make embed-web' or Docker build)
apps/server/internal/frontend/web/*
!apps/server/internal/frontend/web/.gitkeep

# SQLite runtime databases (never commit actual DB files)
*.db
*.db-shm
*.db-wal
peekaping.db*

# Compiled server binaries
apps/server/api
apps/server/engine
apps/server/cmd/engine/engine

# Personal AI assistant / editor tool config dirs (local only)
.agent/
.claude/
.cursor/
.opencode/
